table inet stv_cf_origin
delete table inet stv_cf_origin
table inet stv_cf_origin {
	set cf4 { type ipv4_addr; flags interval; elements = { 173.245.48.0/20, 103.21.244.0/22, 103.22.200.0/22, 103.31.4.0/22, 141.101.64.0/18, 108.162.192.0/18, 190.93.240.0/20, 188.114.96.0/20, 197.234.240.0/22, 198.41.128.0/17, 162.158.0.0/15, 104.16.0.0/13, 104.24.0.0/14, 172.64.0.0/13, 131.0.72.0/22 } }
	set cf6 { type ipv6_addr; flags interval; elements = { 2400:cb00::/32, 2606:4700::/32, 2803:f800::/32, 2405:b500::/32, 2405:8100::/32, 2a06:98c0::/29, 2c0f:f248::/32 } }
	chain gate {
		type filter hook forward priority filter - 10; policy accept;
		iifname "ens3" ct status dnat ct original proto-dst { 80, 443 } ip saddr != @cf4 limit rate 10/minute burst 5 packets log prefix "stv-cf-drop: "
		iifname "ens3" ct status dnat ct original proto-dst { 80, 443 } ip saddr != @cf4 counter drop
		iifname "ens3" ct status dnat ct original proto-dst { 80, 443 } ip6 saddr != @cf6 limit rate 10/minute burst 5 packets log prefix "stv-cf-drop6: "
		iifname "ens3" ct status dnat ct original proto-dst { 80, 443 } ip6 saddr != @cf6 counter drop
	}
}
